# Copy to .env and fill. NEVER commit .env
OPENROUTER_API_KEY=sk-or-v1-...
# Бесплатная по умолчанию: демо и клики не тратят токены.
# Переключить можно в дашборде (карточка Model) или здесь.
OPENROUTER_MODEL=minimax/minimax-m3:free

# baw CLI (Binance Agentic Wallet)
# Install: curl -fsSL https://raw.githubusercontent.com/binance-agentic-wallet/baw/main/install.sh | bash
# Then run: baw auth signin  (interactive OAuth PKCE)
BAW_PATH=baw

# Risk limits (enforced in Python, not by the LLM)
MAX_POSITION_USD=50
MAX_DAILY_LOSS_USD=10
MAX_TRADES_PER_DAY=3
MAX_LEVERAGE=2

# Set to 1 to use synthetic market data (dev only)
# In production, replace mock with public Binance REST API or websocket
ALLOW_MOCK_MARKET=1