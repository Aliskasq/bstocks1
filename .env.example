# Copy to .env and fill. NEVER commit .env
OPENROUTER_API_KEY=sk-or-v1-...
# Бесплатная модель с tool-calling (рекомендуется для хакатона):
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Альтернативы (free + tools): minimax/minimax-m3:free, meta-llama/llama-3.1-8b-instruct:free

# baw CLI (Binance Agentic Wallet) — для DEX торговли bStocks на BSC
# Install: curl -fsSL https://raw.githubusercontent.com/binance-agentic-wallet/baw/main/install.sh | bash
# Then run: baw auth signin  (интерактивный OAuth PKCE через браузер)
BAW_PATH=baw

# Risk limits (enforced in Python, NOT by the LLM)
MAX_POSITION_USD=6
MAX_DAILY_LOSS_USD=10
MAX_TRADES_PER_DAY=3
MAX_LEVERAGE=2

# Market data source: 0 = Binance REST API (live), 1 = synthetic mock (dev only)
ALLOW_MOCK_MARKET=0

# BSCScan API key for contract verification (optional, get from https://bscscan.com/apis)
BSCSCAN_API_KEY=